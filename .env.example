# Compliance and source inventory
OPERATING_REGION={{OPERATING_REGION}}
REPO_DIRS={{REPO_DIRS}}
DEFAULT_PHONE_REGION=US

# Database
DB_ADMIN_USER={{DB_ADMIN_USER}}
DB_ADMIN_PASS={{DB_ADMIN_PASS}}
DB_HOST={{DB_HOST}}
DB_PORT={{DB_PORT}}
DB_NAME={{DB_NAME}}
DATABASE_URL=postgresql://{{DB_ADMIN_USER}}:{{DB_ADMIN_PASS}}@{{DB_HOST}}:{{DB_PORT}}/{{DB_NAME}}

# Queue
REDIS_URL={{REDIS_URL}}

# SMTP/email (leave blank for inbox-only mode)
SMTP_HOST={{SMTP_HOST}}
SMTP_PORT={{SMTP_PORT}}
SMTP_USER={{SMTP_USER}}
SMTP_PASS={{SMTP_PASS}}
SMTP_FROM={{SMTP_FROM}}
OUTREACH_MODE=inbox_only
OUTREACH_COOLDOWN_HOURS=168
MAX_OUTREACH_RETRIES=3

# Official WhatsApp Business API only; blank means manual handshake
WHATSAPP_API_URL={{WHATSAPP_API_URL}}
WHATSAPP_TOKEN={{WHATSAPP_TOKEN}}

# SIP/PBX
SIP_TRUNK_HOST={{SIP_TRUNK_HOST}}
SIP_USERNAME={{SIP_USERNAME}}
SIP_PASSWORD={{SIP_PASSWORD}}
SIP_FROM_NUMBER={{SIP_FROM_NUMBER}}
AGENCY_PHONE_NUMBER={{AGENCY_PHONE_NUMBER}}
WHATSAPP_PHONE_NUMBER={{WHATSAPP_PHONE_NUMBER}}

# Domain/TLS/DNS
AGENCY_DOMAIN={{AGENCY_DOMAIN}}
TLS_EMAIL={{TLS_EMAIL}}

# Object storage
S3_ENDPOINT={{S3_ENDPOINT}}
S3_ACCESS_KEY={{S3_ACCESS_KEY}}
S3_SECRET_KEY={{S3_SECRET_KEY}}
S3_BUCKET={{S3_BUCKET}}

# Inputs and legal text
SEED_LEADS_CSV={{SEED_LEADS_CSV}}
OPT_IN_TEXT_EMAIL={{OPT_IN_TEXT_EMAIL}}
OPT_IN_TEXT_WHATSAPP={{OPT_IN_TEXT_WHATSAPP}}
CALL_DISCLOSURE_TEXT={{CALL_DISCLOSURE_TEXT}}
OWNER_PHONE={{OWNER_PHONE}}
OWNER_EMAIL={{OWNER_EMAIL}}
